# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Replace with your actual MongoDB Atlas connection string in .env
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/provision_store?retryWrites=true&w=majority

# JWT Configurations
JWT_SECRET=super_secret_jwt_access_token_key_12345
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_67890
JWT_REFRESH_EXPIRE=7d
